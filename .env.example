# 复制本文件为 .env 并修改：cp .env.example .env
# ============ 必填 ============
# IPC 密码：访问 http://主机:1242 的 WebUI / API 时使用（明文，对应 IPCPasswordFormat=0）
ASF_IPC_PASSWORD=please_change_me_to_a_strong_password

# ============ 可选 ============
# 容器时区
TZ=Asia/Shanghai

# ASF 自身环境变量（透传，一般不需要改）
# ASF_ARGS=--no-restart
# ASF_NETWORK_GROUP=my-group
# ASF_UID=1000
